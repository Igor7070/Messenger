<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стиль заголовка -->
    <style name="PersonalChatsTitleText" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Стиль имени партнера -->
    <style name="PersonalChatsPartnerNameText" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/personal_chats_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Стиль последнего сообщения -->
    <style name="PersonalChatsLastMessageText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/personal_chats_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Стиль временной метки -->
    <style name="PersonalChatsTimestampText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/personal_chats_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Стиль индикатора непрочитанных сообщений -->
    <style name="PersonalChatsUnreadIndicator" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/personal_chats_unread_badge</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>