<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#60A5FA">  <!-- ← твой основной цвет ripple (голубой из темы) -->

    <!-- Маска: делает ripple строго круглым (oval), не выходит за границы иконки -->
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />  <!-- цвет маски не важен, только форма -->
        </shape>
    </item>

</ripple>