<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон карточки участника видеозвонка.

    Раньше карточка была androidx.cardview.widget.CardView. CardView включает
    себе setClipToOutline(true) ради скруглённых углов, а из-за этого SurfaceView
    внутри него перестаёт работать: SurfaceView делает своё видео видимым тем,
    что «пробивает» в окне прозрачное отверстие поверх уже нарисованного, а при
    обрезке по outline это отверстие остаётся внутри слоя карточки и до буфера
    окна не доходит. Поверхность с видео лежит ПОД окном (setZOrderMediaOverlay),
    поэтому её просто не видно — чёрный прямоугольник, хотя кадры рисуются.

    Обычный фон-drawable даёт тот же вид (скруглённый прямоугольник того же
    цвета), но не включает обрезку по outline, и отверстие пробивается нормально.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#3A3A55"/>
    <corners android:radius="8dp"/>
</shape>
