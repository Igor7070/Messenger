<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран видеозвонка.

    Прежде здесь были отладочные часы («Start:», «Current:»), полоса графика и
    одна прямоугольная кнопка «End Call», а своё видео прямоугольником налезало
    на заголовок. Теперь собеседник занимает весь экран, своё видео — окошком в
    углу, а под рукой обычный для видеозвонка набор: микрофон, камера, смена
    камеры, громкая связь и завершение. Панели уезжают через несколько секунд и
    возвращаются по касанию, чтобы не закрывать картинку.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Видео собеседника на весь экран -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Пока видео собеседника нет (идёт соединение или он выключил камеру),
        вместо черноты — его снимок, имя и состояние.
    -->
    <LinearLayout
        android:id="@+id/no_video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_voice_call_background"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp">

            <ImageView
                android:id="@+id/call_avatar_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/call_incoming_video"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/call_avatar_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_background"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/partner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/no_video_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/call_connecting"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Своё видео: окошко в углу, по касанию меняется местами с собеседником -->
    <FrameLayout
        android:id="@+id/local_video_card"
        android:layout_width="108dp"
        android:layout_height="156dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_video_self"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:padding="1dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/local_video_off_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/call_camera"
            android:src="@drawable/ic_videocam_off"
            android:visibility="gone"
            app:tint="#94A3B8" />
    </FrameLayout>

    <!-- Шапка: кто на связи и сколько идёт разговор -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_video_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/minimize_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/call_minimize"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/call_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/call_connecting"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Кнопки разговора -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_video_scrim_bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mute_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_mute"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_mic_white"
                app:tint="#E2E8F0" />

            <TextView
                android:id="@+id/mute_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_mute"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/camera_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_camera"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_video_call"
                app:tint="#E2E8F0" />

            <TextView
                android:id="@+id/camera_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_camera"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/switch_camera_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_switch_camera"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_camera_switch"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_switch_camera"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/speaker_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_speaker"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_volume_up"
                app:tint="#E2E8F0" />

            <TextView
                android:id="@+id/speaker_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_speaker"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/end_call_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#DC2626"
                android:clickable="true"
                android:contentDescription="@string/call_end"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_call_end_down"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_end"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
