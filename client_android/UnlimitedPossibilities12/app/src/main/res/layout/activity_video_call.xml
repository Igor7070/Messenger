<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Удаленное видео (полноэкранное) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <!-- Локальное видео (маленькое окно в углу) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/local_video_view"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="10dp" />

    <!-- UI элементы -->
    <TextView
        android:id="@+id/call_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Video call"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/call_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/call_timer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="Start: --"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/start_time"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="Current: --"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <com.example.unlimitedpossibilities12.messenger.CallWaveformView
        android:id="@+id/waveform_view"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@id/current_time"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/end_call_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#FF0000"
        android:text="End Call"
        android:textColor="#FFFFFF" />

</RelativeLayout>