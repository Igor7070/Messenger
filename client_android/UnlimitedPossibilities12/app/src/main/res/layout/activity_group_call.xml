<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#2E2A44">

    <!-- Горизонтальный контейнер для заголовка и кнопки переключения режима -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/call_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Group Call"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <!-- Форма плиток участников: Auto / Wide / Tall.
             Видна только в видео-режиме, переключается по кругу. -->
        <Button
            android:id="@+id/tile_mode_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Auto"
            android:textAllCaps="false"
            android:textColor="#67E8F9"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone"
            android:contentDescription="Participant screen shape"/>

        <ImageButton
            android:id="@+id/toggle_mode_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_camera"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:backgroundTint="@null"
            android:visibility="visible"
            android:contentDescription="Toggle between audio and video mode"/>
    </LinearLayout>

    <TextView
        android:id="@+id/call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start: --"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current: --"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        android:paddingBottom="16dp"/>

    <!-- Контейнер для переключения между аудио и видео -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Контейнер для аудио-вкладки (график + список участников) -->
        <LinearLayout
            android:id="@+id/audio_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.example.unlimitedpossibilities12.messenger.CallWaveformView
                android:id="@+id/waveform_view"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/participants_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#3A3A55"/>
        </LinearLayout>

        <!-- Контейнер для видео-вкладки (сетка видеопотоков) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#3A3A55"/>
    </FrameLayout>

    <!-- Контейнер для локального видео и кнопки управления камерой -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_gravity="start|bottom"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <TextView
            android:id="@+id/local_no_video_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No video"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/toggle_camera_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:translationY="2dp"
            android:text="📷"
            android:textSize="18sp"
            android:backgroundTint="#80FFFFFF"
            android:elevation="15dp" />
    </FrameLayout>

    <Button
        android:id="@+id/end_call_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:text="End Call"
        android:backgroundTint="#FF4444"
        android:textColor="#FFFFFF"/>
</LinearLayout>