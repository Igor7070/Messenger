<?xml version="1.0" encoding="utf-8"?>
<!--
    Групповой звонок.

    Прежде это была заготовка с отладкой: часы «Start» и «Current», пустой
    зелёный график во весь верх экрана, заголовок «Group Call with …» с именем
    того, кто позвонил (для самого звонящего — с собой же), список участников
    без снимков и без признаков того, кто уже в разговоре, чёрный прямоугольник
    «No video» в голосовом режиме и единственная прямоугольная кнопка «End
    Call» — ни микрофона, ни громкой связи, ни возможности свернуть.

    Теперь шапка устроена как строка в списке звонков, которая и так делала это
    правильно: снимки участников, их имена и число собеседников. Ниже —
    участники (в голосовом режиме) или сетка видео, внизу — те же круглые
    кнопки, что и в остальных звонках.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_voice_call_background">

    <!-- Свернуть разговор: он продолжается, вернуться можно по полоске сверху -->
    <ImageView
        android:id="@+id/minimize_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/call_minimize"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_chevron_down"
        app:tint="#E2E8F0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Форма плиток: Auto / Wide / Tall. Видна только в видеорежиме. -->
    <TextView
        android:id="@+id/tile_mode_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/call_tile_shape"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/call_tile_auto"
        android:textColor="#67E8F9"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Снимки участников стопкой: кто на связи, видно сразу -->
    <FrameLayout
        android:id="@+id/avatars_row"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/minimize_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/avatars_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal" />
    </FrameLayout>

    <TextView
        android:id="@+id/call_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/avatars_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/call_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/call_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="00:00"
        android:textColor="#CBD5E1"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/call_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Середина: список участников или сетка видео -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/call_timer"
        app:layout_constraintBottom_toTopOf="@id/call_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/participants_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Своё видео: маленькое окно поверх сетки, как в видеозвонке вдвоём -->
    <FrameLayout
        android:id="@+id/local_video_card"
        android:layout_width="96dp"
        android:layout_height="128dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_video_self"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/call_controls">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/local_no_video_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/call_camera_off"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/toggle_camera_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#CC0F172A"
            android:clickable="true"
            android:contentDescription="@string/call_camera"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_video_call"
            app:tint="#E2E8F0" />
    </FrameLayout>

    <!-- Управление разговором: те же кнопки, что в остальных звонках -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mute_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_mute"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_mic_white"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_mute"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/speaker_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_speaker"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_volume_up"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_speaker"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Позвать ещё одного: комната уже есть, ему просто уходит приглашение -->
            <ImageView
                android:id="@+id/add_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_add"
                android:focusable="true"
                android:padding="15dp"
                android:src="@drawable/ic_group_add"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_add"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Камера: она же переключает экран между голосом и видео -->
            <ImageView
                android:id="@+id/toggle_mode_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_camera"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_video_call"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_camera"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/end_call_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#DC2626"
                android:clickable="true"
                android:contentDescription="@string/call_end"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_call_end_down"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_end"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
