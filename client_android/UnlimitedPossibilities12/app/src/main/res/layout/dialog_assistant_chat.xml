<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assistant_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp"
    android:layout_gravity="bottom">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/assistant_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_assistant_molnia"
            android:background="@drawable/assistant_background"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/assistant_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="AI Assistant"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Три точки (меню) -->
        <ImageButton
            android:id="@+id/btn_more_options"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Меню"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <!-- Кнопка развернуть/свернуть -->
        <Button
            android:id="@+id/assistant_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expand ↑"
            android:backgroundTint="#60A5FA"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Основной контейнер с переключением режимов -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Режим ЧАТ (по умолчанию видимый) -->
        <ScrollView
            android:id="@+id/chat_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/assistant_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />
        </ScrollView>

        <!-- Режим ГОЛОСОВОЙ ПЕРЕВОДЧИК (изначально скрыт) -->
        <LinearLayout
            android:id="@+id/translator_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Выбор языка -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Translation language:"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginEnd="12dp" />

                    <Spinner
                android:spinnerMode="dropdown"
                android:dropDownVerticalOffset="0dp"
                android:popupBackground="@drawable/spinner_dropdown_background_translate"
                        android:id="@+id/language_spinner"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Большая круглая кнопка записи -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <androidx.cardview.widget.CardView
                    android:id="@+id/record_button_container"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="90dp"
                    app:cardBackgroundColor="#22C55E"
                    app:cardElevation="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageButton
                        android:id="@+id/btn_record"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_mic_white"
                        android:scaleType="fitCenter"
                        android:tint="#FFFFFF"
                        android:background="@null"
                        android:foreground="@null"
                        android:contentDescription="Начать запись" />
                </androidx.cardview.widget.CardView>

                <!-- Таймер -->
                <TextView
                    android:id="@+id/tv_recording_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="24dp" />
            </FrameLayout>

            <!-- Результат перевода -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E293B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original:"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_original_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:minHeight="60dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#334155"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Translation:"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_translated_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:minHeight="60dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp" />

                    <!-- Кнопки воспроизведения -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp">

                        <ImageButton
                            android:id="@+id/btn_play_original"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:srcCompat="@drawable/ic_volume_up"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="#60A5FA"
                            android:contentDescription="Прослушать оригинал" />

                        <ImageButton
                            android:id="@+id/btn_play_translated"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="16dp"
                            app:srcCompat="@drawable/ic_volume_up"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="#22C55E"
                            android:contentDescription="Listen to the translation" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </FrameLayout>

    <!-- Поле ввода (только для режима чата, будет скрываться) -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0F172A">

        <EditText
            android:id="@+id/assistant_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxHeight="160dp"
            android:minLines="1"
            android:maxLines="5"
            android:minWidth="100dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:inputType="textMultiLine|textCapSentences"
            android:scrollHorizontally="false"
            android:imeOptions="actionSend"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:cursorVisible="true"
            android:hint="Write a message..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@drawable/assistant_input_field"
            android:overScrollMode="never" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/assistant_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:text="➤"
            android:textSize="30sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:gravity="center"
            android:padding="0dp"
            android:background="@drawable/assistant_send_btn"
            android:backgroundTint="#2563EB"
            android:backgroundTintMode="src_atop"
            android:layout_gravity="center_vertical"
            android:contentDescription="Send" />
    </LinearLayout>
</LinearLayout>