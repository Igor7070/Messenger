<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Верхний Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1E2A44"
            android:paddingEnd="8dp">

            <!-- Название раздела — слева, как в мессенджерах -->
            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chats"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#E2E8F0"
                android:layout_gravity="start|center_vertical" />

            <!-- Поиск и меню — справа. Поле поиска разворачивается по значку,
                 постоянного места над списком больше не занимает. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/toolbar_search_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_search"
                    android:padding="9dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Search"
                    android:tint="#CBD5E1" />

                <ImageView
                    android:id="@+id/toolbar_menu_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_menu"
                    android:padding="9dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="More"
                    android:tint="#CBD5E1" />
            </LinearLayout>

            <!-- Прежний значок офлайн-режима: переехал в меню «ещё» -->
            <ImageView
                android:id="@+id/offline_mode_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:src="@drawable/ic_offline_mode"
                android:padding="6dp"
                android:contentDescription="Offline mode"
                android:visibility="gone"
                android:tint="#94A3B8" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Полоса состояния: видна, только когда включён офлайн-режим -->
        <LinearLayout
            android:id="@+id/offline_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A22D3EE"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/offline_strip_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Offline mode is on"
                android:textColor="#A5F3FC"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/offline_strip_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Open"
                android:textColor="#67E8F9"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Вход и выход переехали: вход — отдельный экран при запуске
             (AuthActivity), выход — меню профиля. Кнопки оставлены скрытыми,
             на них ещё ссылается код этого экрана. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Login"
            android:layout_marginTop="12dp"
            app:cornerRadius="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Logout"
            android:layout_marginTop="12dp"
            app:cornerRadius="12dp"
            android:visibility="gone" />

        <!-- Основной контент -->
        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/title_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Users"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#E2E8F0"
                android:gravity="center"
                android:layout_marginBottom="0dp" />

            <!-- Users Container -->
            <LinearLayout
                android:id="@+id/users_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Регистрация — вкладка на экране входа, а не кнопка над
                     списком людей. Скрыто, обработчик в коде сохранён. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_user_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create New User"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />

                <EditText
                    android:id="@+id/search_users_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search users..."
                    android:padding="14dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/edit_text_dark_background"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/users_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:background="#0F172A" />
            </LinearLayout>

            <!-- Chats Container -->
            <!-- Отрицательные отступы гасят поля родителя: строки списка
                 должны идти во всю ширину, как в любом мессенджере -->
            <LinearLayout
                android:id="@+id/chats_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="-16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Создание группы и вступление по ссылке переехали в меню «ещё»
                     и в кнопку «написать». Поля оставлены скрытыми: на них
                     ссылается код экрана. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/chat_name_edit_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:hint="Enter chat name"
                        android:padding="14dp"
                        android:background="@drawable/edit_text_dark_background"
                        android:textColor="#E2E8F0"
                        android:textColorHint="#94A3B8" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/create_chat_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/public_group_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Public group — anyone can find and read it"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/join_by_link_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Join by invite link"
                    android:textColor="#60A5FA"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Разворачивается по значку лупы в шапке -->
                <EditText
                    android:id="@+id/search_chats_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search chats..."
                    android:padding="12dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/edit_text_dark_background"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chats_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp"
                    android:background="#0F172A" />
            </LinearLayout>

            <!-- Calls Container -->
            <LinearLayout
                android:id="@+id/calls_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/calls_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"
                    android:background="#0F172A" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false" />

        </LinearLayout>

        <!-- Кнопка «написать»: новый личный чат, новая группа, вход по ссылке -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/new_chat_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="New chat"
            app:backgroundTint="#6366F1"
            app:tint="#FFFFFF"
            app:elevation="8dp"
            android:visibility="gone" />

        <!-- FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/create_group_call_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@drawable/ic_group_call"
            app:backgroundTint="#6366F1"
            app:tint="#FFFFFF"
            app:elevation="8dp"
            android:visibility="gone" />

        <!-- ====================== КАСТОМНАЯ НИЖНЯЯ ПАНЕЛЬ ====================== -->
        <LinearLayout
            android:id="@+id/custom_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_gravity="bottom"
            android:background="#1E2937"
            android:elevation="12dp"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <!-- Users -->
            <LinearLayout
                android:id="@+id/nav_users_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/nav_users_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_users" />

                <TextView
                    android:id="@+id/nav_users_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contacts"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Group Chats -->
            <LinearLayout
                android:id="@+id/nav_chats_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/nav_chats_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_group_chats" />

                <TextView
                    android:id="@+id/nav_chats_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chats"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Calls -->
            <LinearLayout
                android:id="@+id/nav_calls_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/nav_calls_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_calls" />

                <TextView
                    android:id="@+id/nav_calls_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calls"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/nav_profile_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <!-- Аватар / Иконка -->
                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/nav_profile_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:scaleType="centerInside" />

                    <!-- Круглый аватар (будет виден только когда авторизован) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/nav_profile_avatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/CircleImageStyle"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_profile_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Bar -->
        <LinearLayout
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/rounded_rectangle"
            android:padding="8dp"
            android:elevation="12dp"
            android:visibility="gone"
            android:layout_gravity="bottom">

            <ImageView
                android:id="@+id/delete_selected_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@android:color/white"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/call_delete_button"
                android:padding="12dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Assistant Icon -->
    <ImageView
        android:id="@+id/assistant_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="85dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/ic_assistant_molnia"
        android:background="@drawable/assistant_background"
        android:foreground="@drawable/ripple_assistant"
        android:clickable="true"
        android:focusable="true"
        android:elevation="14dp"
        android:contentDescription="AI Assistant" />

    <!-- Кнопка меню Profile — на самом верхнем уровне -->
    <ImageView
        android:id="@+id/profile_menu_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_menu"
        android:tint="#E2E8F0"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_gravity="top|end"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

</FrameLayout>