<?xml version="1.0" encoding="utf-8"?>
<!--
    Звонок с переводом.

    Прежде главное на экране — расшифровка речи — было зажато между зелёным
    графиком и тремя переключателями, заголовок «Voice communication with …»
    не помещался в ширину, а из управления была одна прямоугольная кнопка
    «End Call»: ни микрофона, ни громкой связи. Ещё здесь оставались
    отладочные часы «Start» и «Current time», которые мы убрали с остальных
    экранов звонка.

    Теперь сверху — кто на связи и сколько идёт разговор, в середине на весь
    рост две расшифровки (своя речь и речь собеседника), внизу — те же
    круглые кнопки, что и в обычном звонке, а настройки перевода открываются
    отдельной панелью и не занимают экран постоянно.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_voice_call_background">

    <!-- Свернуть разговор: он продолжается, вернуться можно по полоске -->
    <ImageView
        android:id="@+id/minimize_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/call_minimize"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_chevron_down"
        app:tint="#E2E8F0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/avatar_card"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/call_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/call_incoming_translated"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/call_avatar_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/call_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#F8FAFC"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/avatar_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/call_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/call_incoming_translated"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/call_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="00:00"
        android:textColor="#CBD5E1"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/call_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Подтверждён ли собеседник; нажатие показывает код для сверки -->
    <LinearLayout
        android:id="@+id/call_security"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/call_timer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/call_security_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/call_security_encrypted"
            android:src="@drawable/ic_lock"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/call_security_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/call_security_checking"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Расшифровка: ради неё этот звонок и затевается, поэтому она в середине -->
    <LinearLayout
        android:id="@+id/transcripts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/call_security"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/call_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/friend_voice_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/call_translate_them"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/friend_transcription_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_transcript_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/friend_transcription_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_translate_listening"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />
        </ScrollView>

        <TextView
            android:id="@+id/your_voice_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="@string/call_translate_you"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/transcription_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_transcript_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/transcription_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_translate_listening"
                android:textColor="#CBD5E1"
                android:textSize="16sp" />
        </ScrollView>
    </LinearLayout>

    <!--
        Настройки перевода: язык, перевод на устройстве и озвучка. Прежде они
        висели на экране постоянно и занимали треть высоты; теперь открываются
        кнопкой и закрываются обратно.
    -->
    <LinearLayout
        android:id="@+id/translation_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_transcript_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/call_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/translation_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/translation_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/call_translate_speech"
                android:textColor="#E2E8F0" />

            <Spinner
                android:id="@+id/language_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="150dp"
                android:popupBackground="@drawable/spinner_dropdown_background_translate" />
        </LinearLayout>

        <TextView
            android:id="@+id/language_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/call_translate_hint"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/on_device_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/call_translate_on_device"
            android:textColor="#E2E8F0" />

        <Switch
            android:id="@+id/tts_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/call_translate_aloud"
            android:textColor="#E2E8F0" />
    </LinearLayout>

    <!-- Кнопки разговора — те же, что в обычном звонке -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mute_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_mute"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_mic_white"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_mute"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/speaker_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_speaker"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_volume_up"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_speaker"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/translate_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_translate_settings"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_globe"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_translate_settings"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/end_call_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#DC2626"
                android:clickable="true"
                android:contentDescription="@string/call_end"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_call_end_down"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/call_end"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
