<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- Username -->
    <FrameLayout
        android:id="@+id/username_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/username_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0" />

        <TextView
            android:id="@+id/status_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textColor="#94A3B8" />
    </FrameLayout>

    <!-- Menu Button -->
    <ImageView
        android:id="@+id/menu_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_menu"
        android:tint="#E2E8F0"
        android:contentDescription="Menu"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:padding="2dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Avatar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/avatar_card"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintTop_toBottomOf="@id/username_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="60dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#172033"
        android:layout_marginTop="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp">

            <ImageView
                android:id="@+id/avatar_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="User avatar" />

            <TextView
                android:id="@+id/avatar_text_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#E2E8F0"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Status Indicator -->
    <View
        android:id="@+id/status_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/circle_green"
        android:visibility="gone"
        android:translationZ="12dp"
        app:layout_constraintEnd_toEndOf="@id/avatar_card"
        app:layout_constraintBottom_toBottomOf="@id/avatar_card"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Avatar Input Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/avatar_input_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_avatar"
        android:textSize="14sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#334155"
        android:textColor="#E2E8F0"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/avatar_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        app:icon="@android:drawable/ic_menu_upload"
        app:iconTint="#E2E8F0" />

    <!-- Bio Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bio_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/avatar_input_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#172033">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/bio_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="About me"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#E2E8F0" />

                <ImageView
                    android:id="@+id/bio_edit_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:tint="#94A3B8"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <TextView
                android:id="@+id/bio_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15.5sp"
                android:textColor="#CBD5E1"
                android:layout_marginTop="8dp"
                android:maxLines="5"
                android:ellipsize="end" />

            <EditText
                android:id="@+id/bio_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15.5sp"
                android:textColor="#E2E8F0"
                android:background="@drawable/edit_text_dark_background"
                android:padding="12dp"
                android:maxLength="244"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Current User Buttons -->
    <LinearLayout
        android:id="@+id/current_user_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/bio_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/update_profile"
            app:cornerRadius="12dp"
            app:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"
            app:icon="@android:drawable/ic_menu_rotate"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/personal_chats_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/personal_chats"
            app:cornerRadius="12dp"
            app:backgroundTint="#8B5CF6"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Send Message -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/send_message_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/send_message"
        android:gravity="center"
        android:textAlignment="center"
        app:iconGravity="start"
        app:iconPadding="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="48dp"
        app:cornerRadius="12dp"
        app:backgroundTint="#14B8A6"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/current_user_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        app:icon="@android:drawable/ic_menu_send"
        app:iconTint="#FFFFFF" />

    <!-- Call Buttons -->
    <LinearLayout
        android:id="@+id/call_buttons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/send_message_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/call"
            app:cornerRadius="12dp"
            app:backgroundTint="#22C55E"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"
            app:icon="@android:drawable/ic_menu_call"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/video_call_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/video_call"
            app:cornerRadius="12dp"
            app:backgroundTint="#EF4444"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Translate Call Container -->
    <LinearLayout
        android:id="@+id/translate_call_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/call_buttons_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/translate_call_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/translate_call"
            app:cornerRadius="12dp"
            app:backgroundTint="#8B5CF6"
            android:textColor="#FFFFFF"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Assistant Icon -->
    <ImageView
        android:id="@+id/assistant_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_assistant_molnia"
        android:background="@drawable/assistant_background"
        android:foreground="@drawable/ripple_assistant"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>