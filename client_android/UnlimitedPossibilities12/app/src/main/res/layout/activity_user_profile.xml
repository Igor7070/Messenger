<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль собеседника.

  Собран как в телефонных мессенджерах: снимок во весь верх, имя и статус
  поверх него внизу, под ним ряд одинаковых плиток действий, затем карточка
  сведений. Прежде имя стояло над маленьким кружком аватара, кнопки шли
  тремя разными рядами, а две трети экрана пустовали.

  Секретный чат и зашифрованный звонок остаются в меню из трёх точек —
  так же, как спрятан секретный чат в телеграме.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Шапка: снимок во всю ширину, под ним затемнение, на нём имя -->
            <FrameLayout
                android:id="@+id/avatar_card"
                android:layout_width="0dp"
                android:layout_height="320dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/avatar_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#172033"
                    android:scaleType="centerCrop"
                    android:contentDescription="User avatar" />

                <!-- Буква имени: когда снимка нет или он не открылся -->
                <TextView
                    android:id="@+id/avatar_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="96sp"
                    android:textStyle="bold"
                    android:textColor="#E2E8F0"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_header_scrim" />

                <LinearLayout
                    android:id="@+id/username_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/username_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <View
                            android:id="@+id/status_indicator"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/circle_green"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/status_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#CBD5E1" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Ряд действий: четыре равные плитки, значок над подписью -->
            <LinearLayout
                android:id="@+id/actions_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/avatar_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/send_message_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_profile_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_send"
                        android:contentDescription="@string/tile_message"
                        app:tint="#A5B4FC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tile_message"
                        android:textSize="12sp"
                        android:textColor="#E2E8F0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/call_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_profile_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calls"
                        android:contentDescription="@string/tile_call"
                        app:tint="#A5B4FC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tile_call"
                        android:textSize="12sp"
                        android:textColor="#E2E8F0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/translate_call_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_profile_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_translate_call"
                        android:contentDescription="@string/tile_translate"
                        app:tint="#A5B4FC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tile_translate"
                        android:textSize="12sp"
                        android:textColor="#E2E8F0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/video_call_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_profile_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_video_call"
                        android:contentDescription="@string/tile_video"
                        app:tint="#A5B4FC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tile_video"
                        android:textSize="12sp"
                        android:textColor="#E2E8F0" />
                </LinearLayout>
            </LinearLayout>

            <!-- Сведения: значение крупно, подпись под ним -->
            <androidx.cardview.widget.CardView
                android:id="@+id/bio_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#172033"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/actions_row"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/bio_text_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="#E2E8F0" />

                            <EditText
                                android:id="@+id/bio_edit_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:imeOptions="actionDone"
                                android:inputType="textMultiLine"
                                android:maxLines="4"
                                android:textSize="16sp"
                                android:textColor="#E2E8F0"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/bio_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_about"
                                android:textSize="12sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/bio_edit_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_edit"
                            android:contentDescription="Edit"
                            android:visibility="gone"
                            app:tint="#94A3B8" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="#1F2A3C" />

                    <TextView
                        android:id="@+id/username_handle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#E2E8F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_username"
                        android:textSize="12sp"
                        android:textColor="#94A3B8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!--
              Что накопилось в переписке: вкладки и список под ними — так
              же, как в карточке человека у телеграма. Пустые разряды
              прячем, а если нет ничего, вкладок нет вовсе.
            -->
            <HorizontalScrollView
                android:id="@+id/shared_tabs_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="12dp"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/bio_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/shared_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/shared_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/shared_tabs_scroll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Своя страница: сменить снимок и прежние две кнопки -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/avatar_input_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/select_avatar"
                android:textSize="14sp"
                android:textColor="#E2E8F0"
                android:visibility="gone"
                app:backgroundTint="#1E293B"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconTint="#A5B4FC"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/shared_list"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/current_user_buttons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/avatar_input_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/update_profile"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#6366F1"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/personal_chats_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/personal_chats"
                    android:textColor="#E2E8F0"
                    app:backgroundTint="#1E293B"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Назад и меню плавают поверх снимка -->
    <ImageView
        android:id="@+id/back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_header_button"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/menu_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu"
        app:tint="#E2E8F0"
        android:contentDescription="Menu"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ассистент доступен отовсюду: живёт в правом нижнем углу над всем -->
    <ImageView
        android:id="@+id/assistant_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_assistant_molnia"
        android:background="@drawable/assistant_background"
        android:foreground="@drawable/ripple_assistant"
        android:contentDescription="Assistant"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
