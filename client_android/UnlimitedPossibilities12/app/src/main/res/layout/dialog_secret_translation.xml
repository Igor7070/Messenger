<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/translate_dialog_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="On-device translation"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/translation_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Secret chat: translation runs on this phone. Messages are never sent to a translation server."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <Switch
        android:id="@+id/translation_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Enable translation"
        android:textColor="#E2E8F0"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/source_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="My language"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/source_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spinner_background_translate"
        android:popupBackground="@drawable/spinner_dropdown_background_translate" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Translate to"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/target_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown"
        android:dropDownVerticalOffset="0dp"
        android:background="@drawable/spinner_background_translate"
        android:popupBackground="@drawable/spinner_dropdown_background_translate" />

    <TextView
        android:id="@+id/pack_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/pack_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/wifi_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Download over Wi-Fi only"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

    <Button
        android:id="@+id/download_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Download language packs"
        android:textAllCaps="false"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Save"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
