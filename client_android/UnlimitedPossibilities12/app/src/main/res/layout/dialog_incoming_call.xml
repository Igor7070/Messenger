<?xml version="1.0" encoding="utf-8"?>
<!--
  Входящий звонок.

  Прежде крупнее всего стояло «Incoming Voice Call», а кто звонит — мельче
  и с предлогом: «From Kenzya». Кнопки-таблетки стояли сразу под именем, в
  верхней трети экрана, а нижние две трети пустовали.

  Теперь имя первым, вид звонка подписью, а ответить и отклонить — два
  круглых значка внизу, разнесённые по краям, как в телефоне.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_voice_call_background">

    <ImageView
        android:id="@+id/call_icon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="40dp"
        android:contentDescription="Caller picture"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.26" />

    <!-- Имя звонящего — первым и крупно -->
    <TextView
        android:id="@+id/caller_name_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginHorizontal="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#F1F5F9"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/call_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Вид звонка: значок и подпись под именем -->
    <LinearLayout
        android:id="@+id/call_type_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/caller_name_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Значок в цвет подписи: прежде он был ярко-синим рядом с серым текстом -->
        <ImageView
            android:id="@+id/call_type_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/call_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_incoming_voice"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <!--
        Приглушить звонок, не отвечая и не отклоняя.
        Прежде это был просто серый текст посреди пустоты — на кнопку не похож,
        и нажать на него никто бы не догадался.
    -->
    <TextView
        android:id="@+id/silence_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_silence_button"
        android:clickable="true"
        android:drawableStart="@drawable/ic_volume_off_offline"
        android:drawablePadding="8dp"
        android:drawableTint="#CBD5E1"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/call_silence"
        android:textColor="#CBD5E1"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/answer_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/answer_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:layout_marginHorizontal="48dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/reject_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#DC2626"
                android:clickable="true"
                android:contentDescription="@string/call_decline"
                android:focusable="true"
                android:padding="18dp"
                android:src="@drawable/ic_call_end_down"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_decline"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/accept_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#16A34A"
                android:clickable="true"
                android:contentDescription="@string/call_answer"
                android:focusable="true"
                android:padding="18dp"
                android:src="@drawable/ic_calls"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_answer"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
