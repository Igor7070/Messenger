<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E2937"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:contentInsetStart="0dp"
        android:contentInsetEnd="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            Шапка устроена так же, как в обычной переписке: слева замок (чтобы
            секретный чат был виден сразу), затем снимок, имя и строка
            состояния, справа — трубка, камера и «три точки».

            Прежде здесь были трубка с замком и глобус. Трубка с замком
            обещала особый «защищённый звонок», которого больше нет: подпись
            теперь в каждом звонке. Глобус же держал перевод в единственном
            месте приложения, где он не в меню.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/secret_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:contentDescription="Secret chat"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_lock"
                app:tint="#67E8F9" />

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/partner_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Аватар собеседника"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/partner_status_indicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-1dp"
                    android:layout_marginBottom="-1dp"
                    android:background="@drawable/status_circle"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chat_name_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Secret Chat"
                    android:textColor="#E2E8F0"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chat_status_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_typing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="typing…"
                    android:textColor="#67E8F9"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Ассистент остаётся отдельной кнопкой, как в обычном чате -->
            <ImageView
                android:id="@+id/assistant_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/assistant_background"
                android:clickable="true"
                android:contentDescription="ИИ-Ассистент"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="@drawable/ripple_assistant"
                android:src="@drawable/ic_assistant_molnia" />

            <ImageView
                android:id="@+id/toolbar_voice_call"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Voice call"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_calls"
                app:tint="#E2E8F0" />

            <ImageView
                android:id="@+id/toolbar_video_call"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Video call"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_video_call"
                app:tint="#E2E8F0" />

            <ImageView
                android:id="@+id/toolbar_overflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="More"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="#E2E8F0" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Предупреждение о смене ключа собеседника (скрыто, пока ключ не менялся) -->
    <TextView
        android:id="@+id/key_changed_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#3A2F0B"
        android:textColor="#FDE68A"
        android:textSize="13sp"
        android:text="⚠ Your contact's encryption key has changed. Tap to check the fingerprint."
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Список сообщений -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:paddingVertical="8dp"
        android:background="#0F172A"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/key_changed_banner"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Поле ввода -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E2937"
        android:padding="8dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Прикреплённый файл -->
        <TextView
            android:id="@+id/attached_file_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="14sp"
            android:textColor="#E2E8F0"
            android:background="#334155"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
            android:drawableTint="#FF6B6B"
            android:drawablePadding="8dp"
            android:gravity="center_vertical" />

        <EditText
            android:id="@+id/input_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your message..."
            android:minHeight="48dp"
            android:padding="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/edit_text_dark_background"
            android:textSize="16sp"
            android:textColor="#E2E8F0"
            android:textColorHint="#94A3B8"
            android:drawableStart="@drawable/ic_attachment"
            android:drawableEnd="@drawable/ic_mic"
            android:drawablePadding="8dp" />
    </LinearLayout>

    <!-- Кружок «к последнему сообщению»: виден, когда лента поднята от конца -->
    <FrameLayout
        android:id="@+id/scroll_down_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/message_list"
        app:layout_constraintBottom_toBottomOf="@id/message_list">

        <ImageView
            android:id="@+id/scroll_down_button"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:layout_margin="6dp"
            android:background="@drawable/bg_scroll_down"
            android:src="@drawable/ic_chevron_down"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="To the latest message"
            app:tint="#CBD5E1" />

        <TextView
            android:id="@+id/scroll_down_count"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:minWidth="20dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:background="@drawable/bg_scroll_down_count"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>


    <!-- Полоса выбора: поднимается поверх шапки, пока выбраны сообщения -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E2937"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/selection_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cancel selection"
            app:tint="#E2E8F0" />

        <TextView
            android:id="@+id/selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="#F1F5F9"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Selected 1" />

        <ImageView
            android:id="@+id/selection_copy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_copy"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Copy"
            app:tint="#E2E8F0" />

        <ImageView
            android:id="@+id/selection_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Edit"
            app:tint="#E2E8F0" />

        <ImageView
            android:id="@+id/selection_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_trash"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Delete"
            app:tint="#FF6B6B" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>