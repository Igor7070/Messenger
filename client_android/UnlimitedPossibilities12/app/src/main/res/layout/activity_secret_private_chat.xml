<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E2937"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:contentInsetStart="0dp"
        android:contentInsetEnd="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Иконка ассистента -->
            <ImageView
                android:id="@+id/assistant_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_assistant_molnia"
                android:background="@drawable/assistant_background"
                android:foreground="@drawable/ripple_assistant"
                android:elevation="4dp"
                android:contentDescription="ИИ-Ассистент"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="12dp" />

            <!-- Перевод на устройстве — у правого края, не влияет на центрирование группы -->
            <ImageView
                android:id="@+id/translate_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_globe"
                android:contentDescription="Перевод на устройстве"
                app:tint="#94A3B8"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Защищённый звонок: личность собеседника проверяется подписью,
                 сервер не может незаметно встать посередине. Раньше его можно
                 было начать только из меню «…» на странице человека. -->
            <ImageView
                android:id="@+id/secure_call_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_call_secure"
                android:contentDescription="Protected call"
                app:tint="#94A3B8"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:layout_constraintEnd_toStartOf="@id/translate_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Центрируемая группа (замок + аватар + имя + typing) -->
            <LinearLayout
                android:id="@+id/center_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Иконка замка -->
                <ImageView
                    android:id="@+id/secret_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Secret Chat"
                    app:tint="#94A3B8"
                    android:layout_marginEnd="12dp" />

                <!-- Аватар -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:id="@+id/partner_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Аватар собеседника" />

                    <View
                        android:id="@+id/partner_status_indicator"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/status_circle"
                        android:visibility="gone"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-1dp"
                        android:layout_marginBottom="-1dp" />
                </FrameLayout>

                <!-- Имя + typing -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/chat_name_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secret Chat"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#E2E8F0"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:maxWidth="240dp"
                        android:gravity="start" />

                    <TextView
                        android:id="@+id/tv_typing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:textColor="#67E8F9"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:text="печатает…"
                        android:gravity="start" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Предупреждение о смене ключа собеседника (скрыто, пока ключ не менялся) -->
    <TextView
        android:id="@+id/key_changed_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#3A2F0B"
        android:textColor="#FDE68A"
        android:textSize="13sp"
        android:text="⚠ Ключ шифрования собеседника изменился. Нажмите, чтобы сверить отпечаток."
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Список сообщений -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:padding="8dp"
        android:background="#0F172A"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/key_changed_banner"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Поле ввода -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E2937"
        android:padding="8dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Прикреплённый файл -->
        <TextView
            android:id="@+id/attached_file_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="14sp"
            android:textColor="#E2E8F0"
            android:background="#334155"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
            android:drawableTint="#FF6B6B"
            android:drawablePadding="8dp"
            android:gravity="center_vertical" />

        <EditText
            android:id="@+id/input_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your message..."
            android:minHeight="48dp"
            android:padding="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/edit_text_dark_background"
            android:textSize="16sp"
            android:textColor="#E2E8F0"
            android:textColorHint="#94A3B8"
            android:drawableStart="@drawable/ic_attachment"
            android:drawableEnd="@drawable/ic_mic"
            android:drawablePadding="8dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>