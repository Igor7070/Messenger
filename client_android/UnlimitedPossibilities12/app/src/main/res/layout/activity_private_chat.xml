<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E2937"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:contentInsetStart="0dp"
        android:contentInsetEnd="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <!-- Аватар с зелёной точкой: такая же, как у аватаров в ленте,
                 только раньше в шапке её не было вовсе -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/partner_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Аватар собеседника" />

                <View
                    android:id="@+id/partner_status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/status_circle"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Имя, а под ним строка состояния: online / печатает / включённые
                 режимы. Прежде под именем было только «печатает…», а режимы
                 занимали отдельную полосу во всю ширину. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/chat_name_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading…"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#E2E8F0"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/chat_status_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_typing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:text="печатает…" />
            </LinearLayout>

            <!-- Ассистент остаётся отдельной кнопкой: им будут пользоваться
                 часто, прятать его в меню нельзя -->
            <ImageView
                android:id="@+id/assistant_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_assistant_molnia"
                android:background="@drawable/assistant_background"
                android:foreground="@drawable/ripple_assistant"
                android:contentDescription="ИИ-Ассистент"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp" />

            <ImageView
                android:id="@+id/toolbar_voice_call"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_calls"
                app:tint="#E2E8F0"
                android:contentDescription="Voice call"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/toolbar_video_call"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_video_call"
                app:tint="#E2E8F0"
                android:contentDescription="Video call"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/toolbar_overflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="#E2E8F0"
                android:contentDescription="More"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Разделительная линия между тулбаром и панелью иконок -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#25334A"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Панель режимов больше не показывается: переключатели переехали в меню
         шапки. Сами вьюхи остаются здесь скрытыми — в их обработчиках живёт
         вся логика, а пункты меню пересылают им нажатие. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/icons_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#1E2937"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Левый блок -->
        <LinearLayout
            android:id="@+id/left_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- TTS -->
            <LinearLayout
                android:id="@+id/tts_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/tts_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_tts"
                    app:tint="#94A3B8"
                    android:contentDescription="Text-to-Speech"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tts_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON"
                    android:textSize="12sp"
                    android:textColor="#67E8F9"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Transcription -->
            <LinearLayout
                android:id="@+id/transcription_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/transcription_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_transcription"
                    app:tint="#94A3B8"
                    android:contentDescription="Transcription"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/transcription_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON"
                    android:textSize="12sp"
                    android:textColor="#67E8F9"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Правый блок -->
        <LinearLayout
            android:id="@+id/right_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Spell Check -->
            <LinearLayout
                android:id="@+id/spell_check_menu_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/spell_check_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SC"
                    android:textSize="14sp"
                    android:textColor="#67E8F9"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/spell_check_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="20sp"
                    android:layout_marginTop="-2dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Translate -->
            <LinearLayout
                android:id="@+id/translation_menu_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/translation_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#67E8F9"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/translation_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_globe"
                    app:tint="#94A3B8"
                    android:contentDescription="Translate"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Список сообщений -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:padding="8dp"
        android:background="#0F172A"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/icons_panel"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Поле ввода -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E2937"
        android:padding="8dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Прикреплённый файл -->
        <TextView
            android:id="@+id/attached_file_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="14sp"
            android:textColor="#E2E8F0"
            android:background="#334155"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
            android:drawableTint="#FF6B6B"
            android:drawablePadding="8dp"
            android:gravity="center_vertical" />

        <!-- Поле ввода + иконки -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/input_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your message..."
                android:minHeight="48dp"
                android:padding="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="64dp"
                android:background="@drawable/edit_text_dark_background"
                android:textSize="16sp"
                android:textColor="#E2E8F0"
                android:textColorHint="#94A3B8"
                android:drawableStart="@drawable/ic_attachment"
                android:drawableTint="#94A3B8"
                android:drawablePadding="8dp" />

            <!-- AI -->
            <ImageView
                android:id="@+id/ai_assist_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_ai_sparkle"
                app:tint="#A5B4FC"
                android:scaleType="centerInside"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="36dp"
                android:contentDescription="AI Assistant"
                android:clickable="true"
                android:focusable="true" />

            <!-- Микрофон -->
            <ImageView
                android:id="@+id/mic_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_mic"
                app:tint="#94A3B8"
                android:scaleType="centerInside"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="Record Audio"
                android:clickable="true"
                android:focusable="true" />

            <!-- Отправить -->
            <ImageView
                android:id="@+id/send_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_send"
                app:tint="#67E8F9"
                android:scaleType="centerInside"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:contentDescription="Send Message"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>