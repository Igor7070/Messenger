<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка звонка.

  Раньше это была карточка с тенью, где самым крупным стояло слово
  «Completed», имя пряталось мелкой подписью под аватаром, а участники
  группового звонка выкладывались плиткой по двое в ряд — строка вырастала
  втрое против соседних. Теперь та же плоская строка, что в чатах и
  контактах: имя первым, под ним направление и вид звонка, время у правого
  края, трубка «перезвонить» в нашей гамме.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="14dp">

        <!-- Второй участник группового звонка: кружок позади первого -->
        <ImageView
            android:id="@+id/call_avatar_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:background="@drawable/circle_background"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/call_avatar_front"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end">

            <ImageView
                android:id="@+id/call_avatar_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/call_avatar_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_background"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/selection_checkmark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/circle_background"
            android:backgroundTint="#6366F1"
            android:contentDescription="@null"
            android:padding="3dp"
            android:src="@drawable/ic_checkmark"
            android:tint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/call_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F1F5F9"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/call_direction_arrow"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_call_made"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/call_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/call_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/call_redial_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Call back"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_calls"
        app:tint="#818CF8" />
</LinearLayout>
