<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/institutionEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Учебное заведение"/>

    <EditText
        android:id="@+id/specializationEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Специальность"/>

    <EditText
        android:id="@+id/yearsEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Годы обучения"/>
</LinearLayout>