<?xml version="1.0" encoding="utf-8"?>
<!--
  Разговор.

  Прежде здесь стояли обрезанный заголовок «Voice communication with …»,
  отладочные строки «Start:» и «Current:», график уровня звука с осью в
  шестьдесят секунд и одна-единственная кнопка «End Call»: ни отключить
  микрофон, ни переключить динамик, ни свернуть звонок было нельзя.

  Теперь экран устроен как в телефоне: собеседник в середине, под ним
  состояние и время разговора, внизу ряд круглых кнопок и красный сброс.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_voice_call_background">

    <!-- Свернуть: звонок продолжается, экран уходит из-под рук -->
    <ImageView
        android:id="@+id/minimize_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/call_minimize"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_chevron_down"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#CBD5E1" />

    <!-- Картинка собеседника: во весь экран, когда камера включена -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/call_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Своя картинка — уголком -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/local_video_view"
        android:layout_width="110dp"
        android:layout_height="170dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Собеседник -->
    <FrameLayout
        android:id="@+id/avatar_card"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.18">

        <ImageView
            android:id="@+id/call_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/call_avatar_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/call_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#F1F5F9"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/avatar_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Состояние: «Connecting…», затем время разговора -->
    <TextView
        android:id="@+id/call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/call_connecting"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/call_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/call_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="00:00"
        android:textColor="#CBD5E1"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/call_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Защита разговора. Звук шифруется всегда, а эта строка говорит, удалось
        ли подтвердить, что по ту сторону именно собеседник. Нажатие
        показывает отпечаток для сверки вслух.
    -->
    <LinearLayout
        android:id="@+id/call_security"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/call_timer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/call_security_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/call_security_encrypted"
            android:src="@drawable/ic_lock"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/call_security_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/call_security_checking"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Кнопки разговора -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mute_button"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_mute"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_mic_white"
                app:tint="#E2E8F0" />

            <TextView
                android:id="@+id/mute_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_mute"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Позвать третьего: разговор продолжится втроём -->
            <ImageView
                android:id="@+id/add_button"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_add"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_group_add"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_add"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Камера: включается прямо в разговоре, как в телеграме -->
            <ImageView
                android:id="@+id/camera_button"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_camera"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_video_call"
                app:tint="#E2E8F0" />

            <TextView
                android:id="@+id/camera_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_camera"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/speaker_button"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:contentDescription="@string/call_speaker"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_volume_up"
                app:tint="#E2E8F0" />

            <TextView
                android:id="@+id/speaker_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_speaker"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/end_call_button"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#DC2626"
                android:clickable="true"
                android:contentDescription="@string/call_end"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_call_end_down"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_end"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
