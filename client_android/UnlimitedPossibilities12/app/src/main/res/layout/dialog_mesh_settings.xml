<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/translate_dialog_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mesh relay"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/switch_mesh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Relay through nearby devices"
        android:textColor="#E2E8F0"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Beta. Messages reach people who are not in direct range by hopping through other phones that have this option on. Text is end-to-end encrypted — relays cannot read it.\n\nUses Bluetooth-only mode: calls, files and voice messages stay direct-only, and transfers are slower. Everyone in the chain needs this app version."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <Switch
        android:id="@+id/switch_test_node"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Test: virtual relay node"
        android:textColor="#FBBF24"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="For testing without a third phone: this phone hosts a fake node behind itself. Other phones see it as Relay-test · via mesh (2 hops), and it echoes messages back through this phone."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <Button
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="Done"
        android:textAllCaps="false" />
</LinearLayout>
