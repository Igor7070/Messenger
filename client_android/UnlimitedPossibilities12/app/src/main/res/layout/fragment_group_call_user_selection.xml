<?xml version="1.0" encoding="utf-8"?>
<!--
    Выбор собеседников для группового звонка.

    Прежде окно было лиловато-серым посреди тёмно-синего приложения, список
    обрывался на полстроки, кнопка кричала заглавными «START A GROUP CALL», а
    о пределе в четырёх человек узнавали, только упёршись в него: на пятом
    выборе выскакивало предупреждение.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_call"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/group_call_new"
        android:textColor="#F8FAFC"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/selection_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="@string/group_call_choose_hint"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/search_users_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/edit_text_dark_background"
        android:hint="@string/group_call_search"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:textColor="#E2E8F0"
        android:textColorHint="#94A3B8"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/users_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="14dp"
        android:fadingEdgeLength="36dp"
        android:requiresFadingEdge="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_call_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:enabled="false"
        android:text="@string/group_call_start"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="#6366F1"
        app:cornerRadius="12dp" />
</LinearLayout>
