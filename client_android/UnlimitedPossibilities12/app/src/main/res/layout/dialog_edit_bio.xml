<?xml version="1.0" encoding="utf-8"?>
<!--
  Правка описания в своём профиле.

  Прежде строка правилась прямо в карточке: клавиатура закрывала её почти
  целиком, и выйти из правки можно было только кнопкой «готово». Окно
  всегда встаёт над клавиатурой, как отдельный экран правки в телеграме.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:background="@drawable/popup_menu_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_about"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/bio_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/edit_text_dark_background"
        android:gravity="top|start"
        android:hint="@string/profile_bio_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="244"
        android:minLines="3"
        android:maxLines="6"
        android:padding="12dp"
        android:textColor="#E2E8F0"
        android:textColorHint="#64748B"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bio_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/cancel"
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bio_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/save"
            android:textColor="#A5B4FC"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
