<?xml version="1.0" encoding="utf-8"?>
<!--
    Просмотр картинки из переписки.

    Прежде здесь был обычный ImageView: приблизить фотографию было нельзя, а
    выйти — только системной кнопкой «назад». Единственная кнопка, скачивание,
    стояла слева сверху, то есть ровно там, где ищут «закрыть».
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- PhotoView умеет щипок и двойное нажатие; она уже используется
         в просмотре аватара, поэтому второй такой же вид писать незачем -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/full_message_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/image_viewer_photo" />

    <!-- Затемнение под кнопками, чтобы они читались на светлой картинке -->
    <View
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_video_scrim_top" />

    <ImageView
        android:id="@+id/close_image_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/image_viewer_close"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/share_message_image_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/image_viewer_share"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_share"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/download_message_image_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/image_viewer_save"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_download"
        app:tint="#FFFFFF" />
</FrameLayout>
