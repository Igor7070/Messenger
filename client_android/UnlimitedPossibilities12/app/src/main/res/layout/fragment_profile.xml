<?xml version="1.0" encoding="utf-8"?>
<!--
  Свой профиль.

  Прежде экран начинался с имени над маленьким кружком, под ним шла таблетка
  «Select New Avatar», карточка-заголовок «About me» и две яркие кнопки
  «Update Profile» и «Personal Chats», а дальше две трети экрана пустовали.
  Теперь это тот же порядок, что и в профиле собеседника: снимок во весь
  верх, имя и присутствие поверх него, ряд плиток, карточка сведений.

  Сменить снимок — кружок с камерой на самом снимке; снимок уходит на сервер
  сразу, отдельная кнопка «обновить» больше не нужна. Описание правится
  карандашом в карточке сведений. Выход и удаление учётной записи остались
  в трёх точках шапки.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="88dp">

        <!-- Шапка: снимок во всю ширину, затемнение, поверх имя и присутствие -->
        <FrameLayout
            android:id="@+id/avatar_card"
            android:layout_width="0dp"
            android:layout_height="320dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/avatar_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#172033"
                android:scaleType="centerCrop"
                android:contentDescription="My avatar" />

            <!-- Буква имени: когда снимка нет или он не открылся -->
            <TextView
                android:id="@+id/avatar_text_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="96sp"
                android:textStyle="bold"
                android:textColor="#E2E8F0"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_header_scrim" />

            <LinearLayout
                android:id="@+id/username_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="76dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/username_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="6" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status_indicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/circle_green"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/status_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#CBD5E1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Сменить снимок: кружок с камерой на самом снимке, как в телефонах -->
            <ImageView
                android:id="@+id/avatar_input_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="14dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/select_avatar"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera_outline"
                app:tint="#E2E8F0" />
        </FrameLayout>

        <!-- Ряд действий: те же плитки, что в профиле собеседника.
             Ассистент здесь — он должен быть под рукой из любого места. -->
        <LinearLayout
            android:id="@+id/actions_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/avatar_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/personal_chats_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_profile_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_group_chats"
                    android:contentDescription="@string/tile_my_chats"
                    app:tint="#A5B4FC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tile_my_chats"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/invite_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_profile_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_group_add"
                    android:contentDescription="@string/tile_invite"
                    app:tint="#A5B4FC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tile_invite"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/assistant_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_profile_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_assistant_molnia"
                    android:contentDescription="@string/tile_assistant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tile_assistant"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
            </LinearLayout>
        </LinearLayout>

        <!-- Сведения: значение крупно, подпись под ним -->
        <androidx.cardview.widget.CardView
            android:id="@+id/bio_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#172033"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/actions_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bio_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#E2E8F0" />

                        <TextView
                            android:id="@+id/bio_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/profile_about"
                            android:textSize="12sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/bio_edit_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Edit"
                        android:src="@drawable/ic_edit"
                        app:tint="#94A3B8" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#1F2A3C" />

                <TextView
                    android:id="@+id/username_handle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#E2E8F0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_username"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Прежние кнопки «Update Profile» и «Personal Chats» убраны: снимок
             уходит сразу, описание сохраняется по готовности, свои чаты
             открываются плиткой выше. Оставлены скрытыми — на них ещё
             ссылается код этого экрана. -->
        <LinearLayout
            android:id="@+id/current_user_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/bio_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/update_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_profile"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
