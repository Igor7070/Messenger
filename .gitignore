# Общий для всего проекта: бэкенд, веб-клиент и Android в одном репозитории.
# Здесь только то, что относится ко всем трём; у каждой части свой .gitignore
# с подробностями.

# Сборки и зависимости — пересоздаются из исходников
**/node_modules/
**/target/
**/build/
**/.gradle/
**/out/
**/dist/

# Локальные настройки машины, а не проекта
**/local.properties
*.iml
.idea/
.vscode/

# Журналы и снимки экрана с перепиской: личные данные, в репозитории им не место
files and logs/
*.log
hs_err_pid*.log
replay_pid*.log

# Служебное
.DS_Store
Thumbs.db

# Личные настройки Claude Code для этого проекта (разрешения конкретной машины)
.claude/settings.local.json
